# Copy to .env.local (gitignored) for local development.
# Never commit real secrets.

# API-Football (api-sports.io direct — NOT RapidAPI)
# Header used: x-apisports-key
APISPORTS_KEY=
# Legacy alias still accepted by the server:
# API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Admin unlock for /admin/* (generate: openssl rand -hex 32)
ADMIN_SECRET=

# Keyless external-slips admin at /admin-slips/<slug>
# Treat the slug like a password (anyone with the URL sees all phones/slips).
# Generate: openssl rand -hex 16
ADMIN_SLIPS_SLUG=

# Keyless external-users admin at /admin-users/<slug>
# Separate from ADMIN_SLIPS_SLUG. Anyone with the URL sees all user histories.
# Generate: openssl rand -hex 16
ADMIN_USERS_SLUG=

# After setting locally, also add to Vercel Production:
#   npx vercel env add APISPORTS_KEY production
#   npx vercel env add ADMIN_SECRET production
#   npx vercel env add ADMIN_SLIPS_SLUG production
#   npx vercel env add ADMIN_USERS_SLUG production
# then redeploy.
